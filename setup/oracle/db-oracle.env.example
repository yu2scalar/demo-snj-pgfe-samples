# Copy to setup/oracle/db-oracle.env (kept out of git, chmod 600) and fill in.
# Read by setup/oracle/setup-db-oracle.sh. On Oracle the three namespaces are three schemas in one
# database; the script creates them.
export ORA_HOST=<host>
export ORA_PORT=1521
# the service name, e.g. ORCL on Amazon RDS for Oracle, FREEPDB1 in the Oracle Free container
export ORA_SERVICE=<service>
# a DBA-level user (on Amazon RDS, the master user) that creates the schemas and owns nothing itself
export ORA_USER=<user>
export ORA_PASSWORD='<password>'
# the Oracle client: sqlplus (Instant Client), or a command that runs it, e.g. in a container:
#   export SQLPLUS="docker exec -i <container> sqlplus"
export SQLPLUS=sqlplus
