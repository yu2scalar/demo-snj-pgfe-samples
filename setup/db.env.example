# Copy to setup/db.env (kept out of git, chmod 600) and fill in. Read by setup/setup-db.sh.
# The three databases must exist, with collation C (the PostgreSQL Frontend requires it), e.g.
#   CREATE DATABASE db_customer OWNER <user> LC_COLLATE 'C' LC_CTYPE 'C' TEMPLATE template0;
export CUSTOMER_DB_HOST=<host>
export CUSTOMER_DB_PORT=5432
export INVENTORY_DB_HOST=<host>
export INVENTORY_DB_PORT=5432
export ORDERING_DB_HOST=<host>
export ORDERING_DB_PORT=5432
# A user that owns the three databases (the same user in each).
export DB_USER=<user>
export DB_PASSWORD='<password>'
